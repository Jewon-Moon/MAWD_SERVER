{
  "name": "mawd",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @mawd/api dev",
    "dev:commerce": "pnpm --filter @mawd/mock-commerce dev",
    "test": "pnpm --filter @mawd/api test",
    "typecheck": "pnpm -r typecheck",
    "start": "pnpm --filter @mawd/api start",
