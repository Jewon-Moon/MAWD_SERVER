    "migrate": "pnpm --filter @mawd/api migrate",
    "seed": "pnpm --filter @mawd/api seed"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.9"
  }
}
