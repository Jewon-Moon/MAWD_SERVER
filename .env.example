# 마이그레이션 전용 (테이블 소유자). 앱 런타임에는 넣지 않습니다.
OWNER_DATABASE_URL=postgres://app_owner:app_owner_dev@localhost:54329/mawd
# 앱 런타임 (RLS 적용 역할). 비밀번호는 drizzle/0001 마이그레이션에서 설정
DATABASE_URL=postgres://app_user:app_user_dev@localhost:54329/mawd
PORT=8000
WEB_ORIGIN=http://localhost:3000
# LLM (OpenAI 호환). 해커톤 당일: LLM_BASE_URL=https://platform.liner.com/api/v1, 모델 liner-gpt-router 등
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL_FAST=gpt-4.1-mini
LLM_MODEL_SMART=gpt-6.1-terra
# 추론 모델을 fast로 쓸 때만: none 이면 추론 끔 (라이너 Router 지원 여부는 당일 확인)
LLM_REASONING_FAST=

# 서버 음성 합성. 비우면 OpenAI + LLM_API_KEY (라이너에는 TTS가 없어서 LLM_BASE_URL을 바꿔도 OpenAI 키가 필요)
TTS_API_KEY=
TTS_MODEL=gpt-4o-mini-tts

# 채널톡 (해커톤 당일 채우기, docs/channeltalk-dayof.md). 키가 비어 있으면 답장을 보내지 않고 로그만 남김
CHANNELTALK_ACCESS_KEY=
CHANNELTALK_ACCESS_SECRET=
CHANNELTALK_WEBHOOK_TOKEN=
CHANNELTALK_BOT_NAME=AI 상담원
CHANNELTALK_API_BASE=https://api.channel.io/open/v5

# Bivia (Articul8 결정 모델: 감정 점수 · 사장님 판단 필요 · 분류 · 욕설 구간). 비우면 LLM 판단으로 대체
BIVIA_API_KEY=
BIVIA_BASE_URL=https://api.articul8.ai/bivia

# 스티비 (반복 이슈 공지 메일). 이메일 생성 · 발송 API는 프로 요금제 이상
STIBEE_API_KEY=
STIBEE_LIST_ID=
STIBEE_API_BASE=https://api.stibee.com/v1

# Vapi (전화 음성: 인식 · 말 끝 감지 · 끼어들기 · 합성). PRIVATE · PUBLIC 키와 PUBLIC_BASE_URL이 다 있어야 켜짐, 없으면 기존 브라우저 통화
VAPI_PRIVATE_KEY=
VAPI_PUBLIC_KEY=
# 비우면 첫 동기화 때 새로 만듦 (서버 재시작 후에도 같은 어시스턴트를 쓰려면 응답의 assistant_id를 여기에)
VAPI_ASSISTANT_ID=
# Vapi 요청 확인용 임의 문자열 (x-mawd-secret 헤더). 비우면 확인 안 함
VAPI_SERVER_SECRET=
# Vapi가 우리 서버를 부를 공개 https 주소 (cloudflared 터널 주소, 끝에 / 없이). localhost는 Vapi가 거부
PUBLIC_BASE_URL=

# 푸시 알림 (FCM). Firebase 콘솔 → 프로젝트 설정
# 서버 발송용: 서비스 계정 → 새 비공개 키 생성 → JSON 파일 경로 (비밀, 저장소에 넣지 말 것)
FIREBASE_SERVICE_ACCOUNT_FILE=
# 브라우저 등록용 (공개 값): 일반 → 웹 앱 설정 / 클라우드 메시징 → 웹 푸시 인증서(VAPID 키)
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_VAPID_KEY=

# EXAONE (LG AI연구원). docs.exaone.ai 에서 무료 키 발급. 넣으면 답변 · 요약 카드 · 예비 판단을 EXAONE으로 전환
# 전환 시: LLM_BASE_URL=https://api.exaone.ai/v1, LLM_API_KEY=(EXAONE 키), LLM_MODEL_FAST/SMART=k-exaone_v2.5
#          기존 OpenAI 키는 TTS_API_KEY로 옮겨 예비 음성 합성에만 사용 (EXAONE은 텍스트 전용)
EXAONE_API_KEY=
# EXAONE은 추론을 끌 수 없음. low가 가장 빠름 (비우면 답변 low · 카드 high)
LLM_REASONING_SMART=
