# ===== 운영 (docker compose) =====
# docker-compose.yml이 이 값으로 Postgres를 만들고 API를 연결. URL에 들어가므로 영문 · 숫자만 (openssl rand -hex 24)
DB_OWNER_PASSWORD=
APP_DB_PASSWORD=
# 서버 바깥 포트 (기본 8000)
API_PORT=8000
WEB_PORT=3000

# 마이그레이션 전용 (테이블 소유자). 앱 런타임에는 넣지 않습니다.
OWNER_DATABASE_URL=postgres://app_owner:app_owner_dev@localhost:54329/mawd
# 앱 런타임 (RLS 적용 역할). 비밀번호는 drizzle/0001 마이그레이션에서 설정
DATABASE_URL=postgres://app_user:app_user_dev@localhost:54329/mawd
PORT=8000
WEB_ORIGIN=http://localhost:3000,http://localhost:5500
# 프론트 주소 (쉼표로 여러 개). 운영: 프론트를 배포한 도메인
# LLM (라이너 Router 기본, OpenAI 호환). LINER_API_KEY 또는 LLM_API_KEY 사용
LINER_API_KEY=
LLM_BASE_URL=https://platform.liner.com/api/v1
LLM_API_KEY=
# 비워두면 매장 설정(liner-gpt-router · liner-claude-router · liner-gemini-router) 사용
LLM_MODEL_FAST=liner-gpt-router
LLM_MODEL_SMART=liner-gpt-router
# 추론 모델을 fast로 쓸 때만: none 이면 추론 끔
LLM_REASONING_FAST=

# 서버 음성 합성 (선택: OpenAI TTS). 비우면 Vapi 또는 브라우저 내장 음성으로 대체
TTS_API_KEY=
TTS_MODEL=gpt-4o-mini-tts

# 채널톡 (해커톤 당일 채우기, docs/channeltalk-dayof.md). 키가 비어 있으면 답장을 보내지 않고 로그만 남김
CHANNELTALK_ACCESS_KEY=
CHANNELTALK_ACCESS_SECRET=
CHANNELTALK_WEBHOOK_TOKEN=
CHANNELTALK_BOT_NAME=AI 상담원
CHANNELTALK_API_BASE=https://api.channel.io/open/v5

# Bivia (Articul8 결정 모델: 감정 점수 · 사장님 판단 필요 · 분류 · 욕설 구간). 비우면 LLM 판단으로 대체
BIVIA_API_KEY=
BIVIA_BASE_URL=https://api.articul8.ai/bivia

# 스티비 (반복 이슈 공지 메일). 이메일 생성 · 발송 API는 프로 요금제 이상
STIBEE_API_KEY=
STIBEE_LIST_ID=
STIBEE_API_BASE=https://api.stibee.com/v1

# Vapi (전화 음성: 인식 · 말 끝 감지 · 끼어들기 · 합성). PRIVATE · PUBLIC 키와 PUBLIC_BASE_URL이 다 있어야 켜짐, 없으면 기존 브라우저 통화
VAPI_PRIVATE_KEY=
VAPI_PUBLIC_KEY=
# 비우면 첫 동기화 때 새로 만듦 (서버 재시작 후에도 같은 어시스턴트를 쓰려면 응답의 assistant_id를 여기에)
VAPI_ASSISTANT_ID=
# Vapi 요청 확인용 임의 문자열 (x-mawd-secret 헤더). 비우면 확인 안 함
VAPI_SERVER_SECRET=
# Vapi가 우리 서버를 부를 공개 https 주소 (cloudflared 터널 주소, 끝에 / 없이). localhost는 Vapi가 거부
PUBLIC_BASE_URL=

# 푸시 알림 (FCM). Firebase 콘솔 → 프로젝트 설정
# 서버 발송용: 서비스 계정 → 새 비공개 키 생성 → JSON 파일 경로 (비밀, 저장소에 넣지 말 것)
FIREBASE_SERVICE_ACCOUNT_FILE=
# 브라우저 등록용 (공개 값): 일반 → 웹 앱 설정 / 클라우드 메시징 → 웹 푸시 인증서(VAPID 키)
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_VAPID_KEY=

# EXAONE (LG AI연구원). docs.exaone.ai 에서 무료 키 발급. 넣으면 답변 · 요약 카드 · 예비 판단을 EXAONE으로 전환
# 전환 시: LLM_BASE_URL=https://api.exaone.ai/v1, LLM_API_KEY=(EXAONE 키), LLM_MODEL_FAST/SMART=k-exaone_v2.5
#          기존 OpenAI 키는 TTS_API_KEY로 옮겨 예비 음성 합성에만 사용 (EXAONE은 텍스트 전용)
EXAONE_API_KEY=
# EXAONE은 추론을 끌 수 없음. low가 가장 빠름 (비우면 답변 low · 카드 high)
LLM_REASONING_SMART=

# 매장별 지식 검색(RAG) 임베딩. 비우면 라이너(openai/text-embedding-3-small) 키를 재사용
EMBED_API_KEY=
EMBED_MODEL=

# 실시간 배송 조회 (Delivery Tracker, console.tracker.delivery 에서 발급). 없으면 주문 데이터 상태로만 안내
TRACKER_CLIENT_ID=
TRACKER_CLIENT_SECRET=

# 외부 커머스 API 키 암호화 (AES-256-GCM, openssl rand -hex 32). 비우면 데모 모드 · CSV 업로드만 가능
SECRETS_KEY=
# 연결된 커머스 플랫폼 자동 동기화 주기(초). 0이면 끔 (기본 300초)
COMMERCE_SYNC_INTERVAL_SEC=300
# 더미 커머스 시연 서버 연동 시 아래에 http://localhost:8100 입력 (비우면 실제 네이버/쿠팡 운영 API 호출)
NAVER_API_BASE=
COUPANG_API_BASE=
MOCK_COMMERCE_PORT=8100
MAWD_API_BASE=http://localhost:8000

# 인스타그램 댓글 연동 (Meta 앱 → Instagram 로그인 방식). 앱 단위 값 (매장별 계정 토큰은 화면에서 연결, 암호화 저장)
# 앱 시크릿: 앱 설정 → 기본 설정. 확인 토큰: 웹훅 등록 시 직접 정한 임의 문자열 (콜백 https://도메인/v1/webhooks/instagram)
INSTAGRAM_APP_SECRET=
# 웹훅 서명 키가 앱 시크릿과 다를 때(인스타그램 로그인 제품의 "Instagram 앱 시크릿") 추가 키, 쉼표로 여러 개
INSTAGRAM_WEBHOOK_SECRETS=
# 놓친 댓글 보완 동기화 주기(초). 너무 짧으면 Meta 요청 한도에 걸려 숨김 · 답글까지 막힘. 0이면 끔
INSTAGRAM_SYNC_INTERVAL_SEC=180
INSTAGRAM_VERIFY_TOKEN=
# 통합 로그인(Unified login) OAuth: 앱 ID(앱 설정 → 기본 설정), 구성 ID(통합 로그인 → 앱 구성에서 만든 구성). 리디렉션 URL은 PUBLIC_BASE_URL/v1/instagram/oauth/callback
INSTAGRAM_APP_ID=
INSTAGRAM_CONFIG_ID=

# 데모 계정 (시드가 만들고 데모 상점에 연결, 더미 커머스 서버도 이 계정으로 로그인). 운영에서는 비밀번호를 꼭 바꾸세요
DEMO_EMAIL=demo@mawd.app
DEMO_PASSWORD=
# 개발 전용: 1이면 로그인 없는 요청을 데모 매장으로 처리 (운영에서는 비우기)
DEV_ANON_TENANT=
